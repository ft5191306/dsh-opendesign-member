{
  "name": "@local/dsh-opendesign-member",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Bind DSH team members to real Open Design conversations",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "scripts/*.js",
    "docs/*.md",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node scripts/test.js",
    "check": "node scripts/check.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
