# Dependencies (this plugin has none by design, but a future change might)
node_modules/

# Test and editor noise
*.log
*.tmp
.DS_Store
Thumbs.db
.vscode/
.idea/

# This plugin's own runtime state, if anyone ever runs it in place
*.pid

# Test scratch. `DSH_TEST_TMP` lets a host that denies Node writes inside
# `os.tmpdir()` point the throwaway directories somewhere writable — measured on
# the Windows box this was developed on, where without it 17 tests failed with
# EPERM from mkdtemp for environmental reasons. The default remains os.tmpdir();
# this only keeps the override's directory out of git.
.tmptest/
